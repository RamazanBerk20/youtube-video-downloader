{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal permissions for the main window: own commands, events, title, theme, folder/file pickers and clipboard read.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text",
    "allow-get-bootstrap",
    "allow-update-settings",
    "allow-set-anyip-password",
    "allow-add-tasks",
    "allow-cancel-task",
    "allow-remove-task",
    "allow-retry-task",
    "allow-cancel-all",
    "allow-clear-finished",
    "allow-open-output-folder",
    "allow-preview-url",
    "allow-dismiss-banner",
    "allow-get-tools-status",
    "allow-install-tool",
    "allow-update-ytdlp",
    "allow-check-app-update",
    "allow-apply-app-update",
    "allow-open-release-page",
    "allow-open-sponsor-page",
    "allow-restart-app",
    "allow-confirm-exit"
  ]
}
