{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Downloader",
  "version": "2.1.0",
  "identifier": "io.github.ramazanberk20.YouTubeDownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YouTube Downloader",
        "width": 1100,
        "height": 880,
        "minWidth": 820,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Video",
    "shortDescription": "Download videos and audio with yt-dlp",
    "longDescription": "A small desktop front-end for yt-dlp with a download queue, format and container options, hardware-accelerated re-encoding and automatic rescue from YouTube rate limits.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/icon.png",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"],
        "recommends": ["ffmpeg"],
        "desktopTemplate": "linux/youtube-downloader.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/youtube-downloader.svg": "icons/icon.svg"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/youtube-downloader.svg": "icons/icon.svg"
        }
      }
    }
  }
}
