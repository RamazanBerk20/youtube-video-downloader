{
  "name": "youtube-downloader",
  "private": true,
  "version": "2.0.2",
  "description": "Fast, small desktop front-end for yt-dlp",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm test && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
